{
  "manifest_version": 3,
  "name": "Site Proxy Switcher",
  "version": "0.1.0",
  "description": "Отправляет выбранные сайты через локальный прокси и показывает их список.",
  "key": "",
  "permissions": ["activeTab", "proxy", "storage"],
  "optional_permissions": ["nativeMessaging"],
  "action": { "default_popup": "popup.html" },
  "options_ui": { "page": "settings.html", "open_in_tab": true }
}
